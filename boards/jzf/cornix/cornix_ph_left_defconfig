# e73 config

CONFIG_ADC_NRFX_SAADC=y

# Enable MPU
CONFIG_ARM_MPU=y

CONFIG_PINCTRL=y

# enable GPIO
CONFIG_GPIO=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_SYNTH=y  # RC->SYNTH: 32MHz xtalから32kを合成しBLE timing精度UP(切断対策)。代償: 消費電力増

# e73 config end

CONFIG_ZMK_SPLIT=y

# 增加键盘的 BLE 无线电的发射功率，用解决延迟和左右通讯不佳的问题
# (peripheral 左にも追加: ドングルとの上り通信を強化し頻繁な切断を解消)
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y

CONFIG_ZMK_STUDIO=n


# RGB
CONFIG_SPI=n

CONFIG_EC11=y
CONFIG_EC11_TRIGGER_GLOBAL_THREAD=y

# split接続を粘り強く: 子機の応答間引き30->10(交信3倍で干渉に強く), 見切り4s->8s(瞬断を切断にしない)
CONFIG_ZMK_SPLIT_BLE_PREF_LATENCY=10
CONFIG_ZMK_SPLIT_BLE_PREF_TIMEOUT=800

# vim: set ft=kconfig: